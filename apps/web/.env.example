# Copy to .env.local and fill in what you need. Everything is optional in development:
# Mogram runs with an embedded database (PGlite) and a development mailbox for sign-in codes.

# Public URL of the app (used for auth origin checks and links).
APP_URL=http://localhost:3100

# Required in production: 32+ random characters (e.g. `openssl rand -hex 32`).
BETTER_AUTH_SECRET=

# Postgres connection string. When empty, PGlite stores data in PGLITE_DATA_DIR.
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# Required in production to email sign-in codes (https://resend.com).
RESEND_API_KEY=
EMAIL_FROM=Mogram <hello@mogram.app>

# Behind a proxy or load balancer, tell Mogram which client IP to trust for rate limits.
# Either the header your proxy sets (e.g. x-real-ip, cf-connecting-ip, fly-client-ip)…
TRUSTED_IP_HEADER=
# …or the proxies (comma-separated CIDRs) allowed to append to x-forwarded-for.
TRUSTED_PROXIES=
# With neither set outside local development, per-IP limits are off (a header anyone can send
# isn't trusted) and the per-address sign-in throttle still applies. See docs/security.md.

# The assistant (optional). Off unless a model provider is set up:
#   Claude:      ANTHROPIC_API_KEY
#   DeepSeek:    DEEPSEEK_API_KEY
#   OpenAI:      AI_PROVIDER=openai, OPENAI_API_KEY, AI_MODEL_FAST (and AI_MODEL_STRONG)
#   Any OpenAI-compatible API: AI_PROVIDER=openai-compatible, AI_API_KEY, AI_BASE_URL, AI_MODEL_FAST
#   Scripted answers for tests and demos, no key: AI_PROVIDER=scripted
# AI_MODEL_FAST answers small edits and questions; AI_MODEL_STRONG builds, plans and reviews.
AI_PROVIDER=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_FAST=
AI_MODEL_STRONG=
# 1 lets people without an account use it: 30 turns a day per address (all of them share one
# allowance without TRUSTED_IP_HEADER). Default: sign in first.
AI_ALLOW_ANONYMOUS=
# Turns per person per day (default 200).
AI_DAILY_TURNS=
