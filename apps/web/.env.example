# Copy to .env.local and fill in what you need. Everything is optional in development:
# Mogram runs with an embedded database (PGlite) and a development mailbox for sign-in codes.

# Public URL of the app (used for auth origin checks and links).
APP_URL=http://localhost:3100

# Required in production: 32+ random characters (e.g. `openssl rand -hex 32`).
BETTER_AUTH_SECRET=

# Postgres connection string. When empty, PGlite stores data in PGLITE_DATA_DIR.
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# Required in production to email sign-in codes (https://resend.com).
RESEND_API_KEY=
EMAIL_FROM=Mogram <hello@mogram.app>

# Behind a proxy or load balancer, tell Mogram which client IP to trust for rate limits.
# Either the header your proxy sets (e.g. x-real-ip, cf-connecting-ip, fly-client-ip)…
TRUSTED_IP_HEADER=
# …or the proxies (comma-separated CIDRs) allowed to append to x-forwarded-for.
TRUSTED_PROXIES=
# With neither set outside local development, per-IP limits are off (a header anyone can send
# isn't trusted) and the per-address sign-in throttle still applies. See docs/security.md.
